
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && request.auth.token.staff == true;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function isBackupAdmin() {
      return signedIn()
        && request.auth.token.backupAdmin == true;
    }

    function canReadSchoolData() {
      return isStaff() || isAdmin() || isBackupAdmin();
    }

    function canManageSchoolData() {
      return isStaff() || isAdmin() || isBackupAdmin();
    }

    function canManageAdmins() {
      return isAdmin() || isBackupAdmin();
    }

    // Teacher Management and staff records
    match /whc_staff/{staffId} {
      allow read: if canManageAdmins();
      allow create, update, delete: if canManageAdmins();
    }

    // Schedule and timetable classes
    match /classes/{classId} {
      allow read: if canReadSchoolData();
      allow create, update, delete:
        if canManageSchoolData();
    }

    // Schedule student records
    match /students/{studentId} {
      allow read: if canReadSchoolData();
      allow create, update, delete:
        if canManageSchoolData();
    }

    // Schedule examination marks
    match /whc_marks/{marksId} {
      allow read: if canReadSchoolData();
      allow create, update, delete:
        if canManageSchoolData();
    }

    // Attendance class configuration
    match /count_classes/{classId} {
      allow read: if canReadSchoolData();
      allow create, update, delete:
        if isAdmin() || isBackupAdmin();
    }

    // Daily attendance records
    match /daily_counts/{countId} {
      allow read: if canReadSchoolData();
      allow create, update: if canManageSchoolData();
      allow delete: if isAdmin() || isBackupAdmin();
    }

    // Attendance website settings
    match /count_settings/{settingId} {
      allow read: if canReadSchoolData();
      allow create, update, delete:
        if isAdmin() || isBackupAdmin();
    }

    // Other collections and nested subcollections
    match /{document=**} {
      allow read, write: if isBackupAdmin();
    }
  }
}